#!/usr/bin/env python3

import os
import rospy
from duckietown.dtros import DTROS, NodeType
from duckietown_msgs.msg import Twist2DStamped

# Parameter für Twist-Befehle
VELOCITY = 0.3  # lineare Geschwindigkeit in m/s, vorwärts (+)
OMEGA    = 2.0  # Winkelgeschwindigkeit in rad/s, gegen den Uhrzeigersinn (+)

class TwistControlNode(DTROS):

    def __init__(self, node_name):
        # Initialisierung des Knotens
        super(TwistControlNode, self).__init__(node_name=node_name, node_type=NodeType.GENERIC)

        # Name des Fahrzeugs aus Umgebungsvariable
        vehicle_name = os.environ['VEHICLE_NAME']

        # Ziel-Topic für Twist-Befehle
        twist_topic  = f"/{vehicle_name}/car_cmd_switch_node/cmd"

        # Speichern der gewünschten Werte für v und omega
        self._v     = VELOCITY
        self._omega = OMEGA

        # Publisher für Bewegungsbefehle
        self._publisher = rospy.Publisher(twist_topic, Twist2DStamped, queue_size=1)

    def run(self):
        # Schleife zur kontinuierlichen Veröffentlichung der Bewegungsbefehle
        rate = rospy.Rate(10)  # Frequenz: 10 Hz
        message = Twist2DStamped(v=self._v, omega=self._omega)
        while not rospy.is_shutdown():
            self._publisher.publish(message)
            rate.sleep()

    def on_shutdown(self):
        # Stoppt das Fahrzeug beim Herunterfahren
        stop = Twist2DStamped(v=0.0, omega=0.0)
        self._publisher.publish(stop)

if __name__ == '__main__':
    node = TwistControlNode(node_name='twist_control_node')
    node.run()
    rospy.spin()

